    "button.secondaryForeground": "#e1e1e1",
    "button.secondaryBackground": "#242424",
    "button.secondaryHoverBackground": "#2c2c2c",
    "button.border": "#e1e1e120",

    "dropdown.background": "#0a0a0a",
