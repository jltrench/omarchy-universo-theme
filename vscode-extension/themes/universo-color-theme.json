    "dropdown.foreground": "#e1e1e1",

    "input.background": "#0a0a0a",
    "input.border": "#323237",
    "input.foreground": "#e1e1e1",
    "input.placeholderForeground": "#5a5a5a",
    "inputOption.activeBackground": "#e1e1e140",
    "inputOption.activeBorder": "#505058",
    "inputValidation.errorBackground": "#420e1420",
    "inputValidation.errorForeground": "#f7768e",
    "inputValidation.errorBorder": "#f7768e",
    "inputValidation.infoBackground": "#7aa2f720",
    "inputValidation.infoForeground": "#7aa2f7",
    "inputValidation.infoBorder": "#7aa2f7",
    "inputValidation.warningBackground": "#e0af6820",
    "inputValidation.warningForeground": "#e0af68",
    "inputValidation.warningBorder": "#e0af68",

    "scrollbar.shadow": "#000000",
    "scrollbarSlider.activeBackground": "#78787880",
